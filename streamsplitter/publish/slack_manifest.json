{
  "display_information": {
    "name": "StreamSplitter",
    "description": "Posts the team's FRC match videos to Slack as they are cut, alerts its owner, and takes start, stop and settings commands by DM.",
    "background_color": "#1f3a5f"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "StreamSplitter",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "files:write",
        "files:read",
        "im:write",
        "im:history",
        "reactions:write",
        "users:read",
        "users:read.email",
        "channels:read",
        "groups:read",
        "channels:join"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
